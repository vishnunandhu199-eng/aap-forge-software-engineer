# Required for Flask secret key
FLASK_SECRET_KEY=your-secret-key

# Choose one provider and set one API key.
# Resend API key (recommended)
RESEND_API_KEY=your-resend-api-key

# Or SendGrid API key
# SENDGRID_API_KEY=your-sendgrid-api-key

# Optional sender address override
EMAIL_FROM_ADDRESS=hello@appforge.com
EMAIL_FROM_NAME=App Forge

# Optional SQLite path for local development
FLASK_TASKS_DB=tasks.db

# Optional database URL for switching to Postgres later
# DATABASE_URL=sqlite:///tasks.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
